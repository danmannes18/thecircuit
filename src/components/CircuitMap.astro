---
// CircuitMap — interactive world map showing The Circuit's 16 locations
// Placed between <Logline /> and <World /> in index.astro
---

<section id="circuit-map" class="circuit-map">
  <div class="circuit-map__header gutter-x">
    <p class="meta circuit-map__eyebrow">The Circuit</p>
    <h2 class="circuit-map__title">One world. <em>Twelve cities. Twelve months.</em></h2>
    <p class="circuit-map__subtitle">From Wellington in January to Geneva in December — the same eighty faces chasing the same trophies across four continents.</p>
  </div>

  <div class="circuit-map__layout gutter-x">
    <div class="circuit-map__map-wrap" id="map-container">
      <svg id="world-map" aria-label="Interactive map of The Circuit show jumping locations" role="img"></svg>
      <p class="map-hint">Drag to pan &nbsp;·&nbsp; Scroll to zoom</p>
    </div>

    <div class="circuit-map__panel" id="info-panel" role="region" aria-live="polite" aria-label="Location details">
      <div class="panel-empty" id="panel-empty">Select a location</div>
      <div class="panel-content" id="panel-content" aria-hidden="true">
        <div class="panel-header">
          <span class="panel-flag" id="panel-flag"></span>
          <span class="panel-name" id="panel-name"></span>
        </div>
        <div class="panel-months" id="panel-months"></div>
        <div class="panel-rule"></div>
        <div class="panel-tagline" id="panel-tagline"></div>
        <div class="panel-body" id="panel-body"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(async function () {
  const locations = [
    { id: 'wellington',   tier: 'ANCHOR', coords: [-80.25, 26.66], label: 'Wellington, FL',    months: 'January – April',   tagline: 'The American Mecca',         flag: '🇺🇸', body: '12 consecutive weeks. 14,000+ horses. The Winter Equestrian Festival is the social and competitive center of American show jumping. The Rolex Grand Prix — $500,000 — closes the season each April.' },
    { id: 'aachen',       tier: 'ANCHOR', coords: [6.08, 50.77],   label: 'Aachen',             months: 'June – July',       tagline: 'The Wimbledon of Equestrian Sport', flag: '🇩🇪', body: 'CHIO Aachen. 200,000+ visitors. Royalty in the stands. The most prestigious horse show in the world — where the Grand Slam begins and national pride is everything. Germany treats this like a national holiday.' },
    { id: 'geneva',       tier: 'ANCHOR', coords: [6.14, 46.20],   label: 'Geneva',             months: 'December',          tagline: "The Season's End",          flag: '🇨🇭', body: "CHI Geneva. A Grand Slam leg. The most elegant indoor show in the sport — where the year closes in Swiss luxury and final rankings are sealed. The FEI headquarters sits nearby in Lausanne." },
    { id: 'spruce',       tier: 'ANCHOR', coords: [-114.07, 50.95], label: 'Spruce Meadows',    months: 'September',         tagline: 'The Grand Slam',             flag: '🇨🇦', body: 'The Spruce Meadows Masters. The third Grand Slam leg. One of the largest and most beloved outdoor horse shows in the world — set against the Canadian Rockies. The prize money and the prestige are both extraordinary.' },
    { id: 'la2028',       tier: 'ANCHOR', coords: [-117.02, 33.60], label: 'Los Angeles 2028',  months: 'July 2028',         tagline: 'The Finale',                 flag: '🏅', body: 'Santa Anita Park, Arcadia, California. The main 2028 Olympic equestrian venue — the first home Games for American equestrians since 1984. Eventing cross-country at Galway Downs, Temecula, one hour south. Six gold medals. Every decision on the circuit for two years points here.' },
    { id: 'hamptons',     tier: 'MAJOR',  coords: [-72.30, 40.93],  label: 'The Hampton Classic', months: 'August',           tagline: 'The Social Show',            flag: '🇺🇸', body: 'The intersection of elite show jumping and the Hamptons summer scene. Celebrities, media, fashion — and serious jumping. Enormously TV-friendly. The most photogenic show in America.' },
    { id: 'lexington',    tier: 'MAJOR',  coords: [-84.50, 38.04],  label: 'Lexington, KY',    months: 'Spring & Fall',     tagline: 'The Horse Capital',          flag: '🇺🇸', body: 'The Kentucky Horse Park. Home of US National Championships, major hunter and jumper events, and the heart of American breeding country. Old horse country — the history runs centuries deep.' },
    { id: 'denbosch',     tier: 'MAJOR',  coords: [5.30, 51.69],    label: 'Den Bosch',         months: 'March',             tagline: 'The Dutch Masters',          flag: '🇳🇱', body: 'A Grand Slam leg and major World Cup qualifier. The Netherlands is a show jumping superpower — Dutch and Belgian warmbloods power this sport. Den Bosch draws some of the largest crowds of the indoor season.' },
    { id: 'windsor',      tier: 'MAJOR',  coords: [-0.61, 51.48],   label: 'Royal Windsor',     months: 'May',               tagline: 'In the Grounds of a Castle', flag: '🇬🇧', body: 'Show jumping in the shadow of Windsor Castle. British royalty in the stands. One of the most visually spectacular settings in the sport — a combination of institutional prestige and extraordinary scenery.' },
    { id: 'barcelona',    tier: 'MAJOR',  coords: [2.15, 41.39],    label: 'Barcelona',         months: 'September',         tagline: 'CSIO Barcelona',             flag: '🇪🇸', body: "A top-tier Nations Cup show at one of Europe's most beautiful venues. Late September in Barcelona means the close of the outdoor European season — high stakes, high atmosphere." },
    { id: 'rome',         tier: 'KEY',    coords: [12.49, 41.89],   label: 'Rome',              months: 'Spring',            tagline: 'Piazza di Siena',            flag: '🇮🇹', body: "The Piazza di Siena in Rome's Villa Borghese — one of the most photographed settings in all of equestrian sport. The Global Champions Tour stop in Rome is a highlight of the spring European circuit." },
    { id: 'verona',       tier: 'KEY',    coords: [10.99, 45.43],   label: 'Verona',            months: 'November',          tagline: 'The Roman Arena',            flag: '🇮🇹', body: 'Jumping Verona. An indoor World Cup qualifier held in a Roman arena — one of the most dramatically cinematic venues in the sport. The ancient stones and modern sport create an unmistakable image.' },
    { id: 'monaco',       tier: 'KEY',    coords: [7.42, 43.73],    label: 'Monaco',            months: 'Spring',            tagline: 'Global Champions Tour',      flag: '🇲🇨', body: "The Global Champions Tour brings show jumping to the world's wealthiest postcode. Monte Carlo harbor as backdrop. Sponsorship wealth on full display. The most glamorous stop on the European circuit." },
    { id: 'hamburg',      tier: 'KEY',    coords: [9.99, 53.55],    label: 'Hamburg',           months: 'May',               tagline: 'Global Champions Tour',      flag: '🇩🇪', body: 'Derby Park — home of the Hamburg Derby, one of the most technically demanding courses in show jumping. A classic venue with deep history, now also a key GCT stop.' },
    { id: 'thermal',      tier: 'KEY',    coords: [-116.14, 33.64], label: 'Thermal, CA',       months: 'January – March',   tagline: 'Desert International',       flag: '🇺🇸', body: 'The Desert International Horse Park in the Coachella Valley. The West Coast equivalent of Wellington — a growing hub for California\'s equestrian wealth and the tech and entertainment money that has moved into the sport.' },
    { id: 'tryon',        tier: 'KEY',    coords: [-82.23, 35.20],  label: 'Tryon, NC',         months: 'Summer & Fall',     tagline: 'Tryon International',        flag: '🇺🇸', body: 'A massive purpose-built equestrian resort in the Blue Ridge Mountains. Hosted the 2018 World Equestrian Games. A key venue for US domestic championships — the anchor of the American Southeast circuit.' },
    { id: 'traversecity', tier: 'MAJOR',  coords: [-85.62, 44.76],  label: 'Traverse City, MI', months: 'Summer',            tagline: 'Horse Show By The Bay',      flag: '🇺🇸', body: 'Horse Show By The Bay on the shores of Grand Traverse Bay in northern Michigan — one of the most scenically spectacular venues in American equestrian sport. A destination show where Great Lakes summer and serious competition meet.' },
    { id: 'galwaydowns',  tier: 'KEY',    coords: [-117.02, 33.49], label: 'Galway Downs',       months: 'July 2028',         tagline: 'LA28 Eventing Cross-Country', flag: '🇺🇸', body: 'The 2028 Olympic eventing cross-country venue, one hour south of Los Angeles. 242 acres of working racehorse facility, retrofitted for the Games. Where the most dangerous and most cinematic phase of Olympic eventing takes place.' },
  ];

  const D3_URL = 'https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js';
  const TOPOJSON_URL = 'https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js';
  // 50m gives enough coastline detail to show the Great Lakes properly
  const WORLD_URL  = 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json';
  // US states in geographic coordinates (WGS84 GeoJSON)
  const STATES_URL = 'https://cdn.jsdelivr.net/gh/PublicaMundi/MappingAPI/data/geojson/us-states.json';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  let activeId = null;

  function isMobile() { return window.innerWidth < 768; }

  function updatePanel(loc) {
    const emptyEl   = document.getElementById('panel-empty');
    const contentEl = document.getElementById('panel-content');

    if (!loc) {
      emptyEl.style.display = 'flex';
      contentEl.style.display = 'none';
      contentEl.setAttribute('aria-hidden', 'true');
      return;
    }

    document.getElementById('panel-flag').textContent    = loc.flag;
    document.getElementById('panel-name').textContent    = loc.label;
    document.getElementById('panel-months').textContent  = loc.months;
    document.getElementById('panel-tagline').textContent = loc.tagline;
    document.getElementById('panel-body').textContent    = loc.body;

    emptyEl.style.display = 'none';
    contentEl.style.display = 'block';
    contentEl.removeAttribute('aria-hidden');

    if (!reducedMotion) {
      contentEl.style.opacity = '0';
      contentEl.style.transform = 'translateY(8px)';
      requestAnimationFrame(() => {
        contentEl.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
        contentEl.style.opacity = '1';
        contentEl.style.transform = 'translateY(0)';
      });
    } else {
      contentEl.style.opacity = '1';
      contentEl.style.transform = 'none';
    }
  }

  function initMap() {
    const container = document.getElementById('map-container');
    const svgEl     = document.getElementById('world-map');
    const svg       = d3.select(svgEl);

    let width, height, projection, path;
    // Pre-computed screen coords for each location at the base projection
    let projPts = {};

    function setupDims() {
      width  = container.clientWidth;
      height = container.clientHeight;
      svg.attr('width', width).attr('height', height);
    }
    setupDims();

    function setupProjection() {
      projection = d3.geoNaturalEarth1().scale(1).translate([0, 0]);
      const b = d3.geoPath().projection(projection).bounds({ type: 'Sphere' });
      const s = 0.95 / Math.max((b[1][0] - b[0][0]) / width, (b[1][1] - b[0][1]) / height);
      projection.scale(s).translate([
        (width  - s * (b[1][0] + b[0][0])) / 2,
        (height - s * (b[1][1] + b[0][1])) / 2,
      ]);
      path = d3.geoPath().projection(projection);
      // Cache screen positions at scale=1 zoom
      projPts = {};
      locations.forEach(l => { projPts[l.id] = projection(l.coords); });
    }
    setupProjection();

    // Background
    const bgRect = svg.append('rect')
      .attr('width', width).attr('height', height).attr('fill', '#0f1e3d');

    // Zoomable group — only map geography lives here
    const mapGroup = svg.append('g').attr('class', 'map-g');

    // Pins live in a separate group that is NOT inside mapGroup.
    // We manually reposition them on every zoom event so they stick to
    // their geographic coordinates while staying a constant screen size.
    const pinGroup = svg.append('g').attr('class', 'pin-group').attr('pointer-events', 'all');

    // Current zoom transform (kept in sync with zoom events)
    let currentTransform = d3.zoomIdentity;

    // Convert a base-projection point to current screen position
    function toScreen(pt) {
      return [
        currentTransform.x + currentTransform.k * pt[0],
        currentTransform.y + currentTransform.k * pt[1],
      ];
    }

    // Batch-reposition all pins to match the current transform (single selection pass)
    function repositionPins() {
      pinGroup.selectAll('.pin').attr('transform', function() {
        const pt = projPts[d3.select(this).attr('data-id')];
        if (!pt) return null;
        const [sx, sy] = toScreen(pt);
        return `translate(${sx},${sy})`;
      });
    }

    // Zoom behaviour
    const zoom = d3.zoom()
      .scaleExtent([0.5, 12])
      .on('zoom', (event) => {
        currentTransform = event.transform;
        mapGroup.attr('transform', currentTransform);
        repositionPins();
      });

    svg.call(zoom).on('dblclick.zoom', null);

    function fitPins(animate) {
      // Always fit to ANCHOR cities — other tiers are discoverable by panning
      const pts = locations
        .filter(l => l.tier === 'ANCHOR')
        .map(l => projPts[l.id])
        .filter(Boolean);
      const xs  = pts.map(p => p[0]);
      const ys  = pts.map(p => p[1]);
      const pad = Math.min(width, height) * 0.14;
      const x0  = Math.min(...xs) - pad, x1 = Math.max(...xs) + pad;
      const y0  = Math.min(...ys) - pad, y1 = Math.max(...ys) + pad;
      const k   = Math.min(width / (x1 - x0), height / (y1 - y0));
      const tx  = width  / 2 - k * (x0 + x1) / 2;
      const ty  = height / 2 - k * (y0 + y1) / 2;
      const t   = d3.zoomIdentity.translate(tx, ty).scale(k);
      if (animate && !reducedMotion) {
        svg.transition().duration(600).ease(d3.easeCubicOut).call(zoom.transform, t);
      } else {
        svg.call(zoom.transform, t);
      }
    }

    function drawMap(worldData, statesData) {
      mapGroup.selectAll('*').remove();

      // Graticule
      mapGroup.append('path')
        .datum(d3.geoGraticule().step([10, 10])())
        .attr('d', path).attr('fill', 'none')
        .attr('stroke', 'rgba(255,255,255,0.05)').attr('stroke-width', 0.5);

      // Land (countries-50m has enough resolution to show Great Lakes as water holes)
      mapGroup.append('path')
        .datum(topojson.feature(worldData, worldData.objects.countries))
        .attr('d', path).attr('fill', '#3f5f3f');

      // Country borders
      mapGroup.append('path')
        .datum(topojson.mesh(worldData, worldData.objects.countries, (a, b) => a !== b))
        .attr('d', path).attr('fill', 'none')
        .attr('stroke', '#7b8c5c').attr('stroke-width', 0.3);

      // US state borders — same visual weight as country borders but lighter
      if (statesData) {
        mapGroup.append('g').attr('class', 'states')
          .selectAll('path')
          .data(statesData.features)
          .join('path')
          .attr('d', path)
          .attr('fill', 'none')
          .attr('stroke', '#7b8c5c')
          .attr('stroke-width', 0.2)
          .attr('stroke-opacity', 0.55);
      }

      // Route arcs — great-circle lines between ANCHOR cities
      const anchors = locations.filter(l => l.tier === 'ANCHOR');
      const arcG = mapGroup.append('g').attr('class', 'arcs');
      for (let i = 0; i < anchors.length; i++) {
        for (let j = i + 1; j < anchors.length; j++) {
          arcG.append('path')
            .datum({ type: 'LineString', coordinates: [anchors[i].coords, anchors[j].coords] })
            .attr('d', path).attr('fill', 'none')
            .attr('stroke', 'rgba(201,168,118,0.15)').attr('stroke-width', 0.6);
        }
      }
    }

    function drawPins() {
      pinGroup.selectAll('*').remove();

      const mobile  = isMobile();
      const visible = mobile ? locations.filter(l => l.tier === 'ANCHOR') : locations;

      visible.forEach((loc, i) => {
        const [sx, sy] = toScreen(projPts[loc.id]);
        const r    = loc.tier === 'ANCHOR' ? 6 : loc.tier === 'MAJOR' ? 4.5 : 3;
        const fill = loc.tier === 'ANCHOR' ? '#c9a876'
                   : loc.tier === 'MAJOR'  ? 'rgba(201,168,118,0.75)'
                   :                         'rgba(201,168,118,0.45)';

        const g = pinGroup.append('g')
          .attr('class', `pin pin--${loc.tier.toLowerCase()}`)
          .attr('data-id', loc.id)
          .attr('transform', `translate(${sx},${sy})`)
          .attr('tabindex', '0').attr('role', 'button')
          .attr('aria-label', `View details for ${loc.label}`)
          .style('cursor', 'pointer');

        if (!reducedMotion) g.style('opacity', '0');

        // Invisible larger hit area
        g.append('circle').attr('r', Math.max(r + 6, 12))
          .attr('fill', 'transparent').attr('stroke', 'none');

        // Main dot
        g.append('circle').attr('class', 'dot').attr('r', r).attr('fill', fill)
          .attr('stroke', loc.tier === 'ANCHOR' ? 'rgba(255,255,255,0.8)' : 'none')
          .attr('stroke-width', loc.tier === 'ANCHOR' ? 0.8 : 0);

        // Pulse ring (shown on click)
        g.append('circle').attr('class', 'pulse-ring').attr('r', r)
          .attr('fill', 'none').attr('stroke', '#c9a876').attr('stroke-width', 1.5)
          .style('opacity', '0').style('pointer-events', 'none');

        // Label — always visible for all tiers, larger for ANCHOR
        const fontSize = loc.tier === 'ANCHOR' ? '9px' : loc.tier === 'MAJOR' ? '8px' : '7.5px';
        const labelOpacity = loc.tier === 'ANCHOR' ? 1 : loc.tier === 'MAJOR' ? 0.85 : 0.7;
        g.append('text')
          .attr('class', 'pin-label')
          .attr('y', -(r + 6)).attr('text-anchor', 'middle')
          .attr('font-family', 'var(--font-mono,"JetBrains Mono Variable",monospace)')
          .attr('font-size', fontSize)
          .attr('fill', '#e8d9bd')
          .attr('fill-opacity', labelOpacity)
          .attr('letter-spacing', '0.07em')
          .style('text-transform', 'uppercase')
          .style('text-shadow', '0 1px 4px rgba(0,0,0,0.9), 0 0 8px rgba(0,0,0,0.6)')
          .style('pointer-events', 'none')
          .text(loc.label.toUpperCase());

        g.on('click', () => handlePin(loc, g, r));
        g.on('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); handlePin(loc, g, r); }
        });

        if (!reducedMotion) {
          setTimeout(() => g.transition().duration(300).style('opacity', '1'), i * 50);
        }
      });
    }

    function deactivatePin(id) {
      const prev = pinGroup.select(`[data-id="${id}"]`);
      const prevLoc = locations.find(l => l.id === id);
      if (prevLoc) prev.select('.dot').attr('stroke', prevLoc.tier === 'ANCHOR' ? 'rgba(255,255,255,0.8)' : 'none').attr('stroke-width', prevLoc.tier === 'ANCHOR' ? 0.8 : 0);
    }

    function handlePin(loc, gSel, r) {
      if (activeId && activeId !== loc.id) deactivatePin(activeId);

      if (activeId === loc.id) {
        activeId = null;
        updatePanel(null);
        deactivatePin(loc.id);
      } else {
        activeId = loc.id;
        updatePanel(loc);
        gSel.select('.dot').attr('stroke', '#c9a876').attr('stroke-width', 1.5);

        if (!reducedMotion) {
          const ring = gSel.select('.pulse-ring');
          ring.attr('r', r).style('opacity', '1')
            .transition().duration(600).ease(d3.easeCubicOut)
            .attr('r', r + 12).style('opacity', '0')
            .on('end', function() { d3.select(this).attr('r', r); });
        }
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeId !== null) {
        deactivatePin(activeId);
        activeId = null;
        updatePanel(null);
      }
    });

    // Load world and states in parallel
    Promise.all([
      fetch(WORLD_URL).then(r => r.json()),
      fetch(STATES_URL).then(r => r.json()).catch(() => null),
    ]).then(([worldData, statesData]) => {
      drawMap(worldData, statesData);
      fitPins(false);
      drawPins();

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          setupDims();
          bgRect.attr('width', width).attr('height', height);
          setupProjection();
          drawMap(worldData, statesData);
          fitPins(false);
          drawPins();
        }, 150);
      });
    }).catch(err => console.error('CircuitMap: failed to load map data', err));
  }

  try {
    await loadScript(D3_URL);
    await loadScript(TOPOJSON_URL);
    initMap();
  } catch (err) {
    console.error('CircuitMap: failed to load map libraries', err);
  }
})();
</script>

<style>
  .circuit-map {
    background: var(--color-bay-deep);
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }

  .circuit-map__header {
    max-width: 72rem;
    margin: 0 auto;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .circuit-map__eyebrow {
    color: var(--color-sand-deep);
    margin-bottom: 1.5rem;
  }

  .circuit-map__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-paper);
    margin: 0 0 1.25rem;
  }

  .circuit-map__title em {
    font-style: italic;
    font-variation-settings: "opsz" 144, "SOFT" 60, "WONK" 1;
    color: var(--color-sand-deep);
  }

  .circuit-map__subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.0625rem);
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.7);
    max-width: 52ch;
    margin: 0;
  }

  /* Layout */
  .circuit-map__layout {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 65fr 35fr;
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }

  .circuit-map__map-wrap {
    width: 100%;
    height: 56vh;
    min-height: 280px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  #world-map {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  #world-map:active { cursor: grabbing; }

  .map-hint {
    position: absolute;
    bottom: 0.75rem;
    right: 0.875rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(232, 217, 189, 0.35);
    pointer-events: none;
    margin: 0;
  }

  /* Info panel */
  .circuit-map__panel {
    background: rgba(31, 15, 10, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(201, 168, 118, 0.2);
    border-radius: 4px;
    min-height: 120px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-self: stretch;
  }

  .panel-empty {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(232, 217, 189, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
  }

  .panel-content {
    display: none;
  }

  .panel-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .panel-flag {
    font-size: 1.25rem;
    line-height: 1;
  }

  .panel-name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1rem + 1vw, 1.5rem);
