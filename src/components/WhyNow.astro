---
// Act Seven — Why Now.
const points = [
  {
    n: "01",
    claim: "Documentary sports has become <em>prestige television.</em>",
    body: "The Last Dance. Free Solo. Full Swing. Break Point. Race for the Crown. Tour de France: Unchained. The character-driven sports documentary has matured into the most reliable subscriber-driver in streaming. Equestrian sport — three Olympic disciplines, the most photogenic in the world, the most globally distributed — has never been given the premium treatment.",
  },
  {
    n: "02",
    claim: "The Premier Jumping League <em>creates the opening.</em>",
    body: "In March 2027, Frank McCourt’s $300M, 16-team Premier Jumping League launches — with the Emmy-winning team behind Drive to Survive producing the broadcast. The PJL is the sport’s F1 moment: mass-market entry point, new audience, new economics. This show is the sport’s Last Dance moment — the prestige character layer that follows the new fan deeper. Their show makes the league. This show makes the world the league lives in.",
  },
  {
    n: "03",
    claim: "The 2028 Los Angeles Olympics is a <em>fixed, marketable finale.</em>",
    body: "The first home Olympics for American equestrians since 1984. Three disciplines. Six gold medals. A two-season series that climaxes at Santa Anita Park is a buyer’s dream: a clean structure, a fixed delivery date, and a guaranteed cultural moment to release into.",
  },
  {
    n: "04",
    claim: "The cast is <em>already famous.</em>",
    body: "Springsteen, Jobs, Cook, Cuoco. The children of the people who built modern America are in this world. So are the greatest dressage rider alive — Isabell Werth, in her 50s and still winning — and the world number one eventer riding horses passed to him from a teammate who can no longer compete. The cast doesn’t need to be manufactured. It’s already loaded.",
  },
  {
    n: "05",
    claim: "No one else has <em>the access.</em>",
    body: "This is a world that runs on relationships, generational trust, and quiet introductions. Whoever gets in first owns this story.",
  },
];
---

<section id="why" class="why">
  <div class="inner">
    <header class="head" data-reveal>
      <p class="meta">The Case</p>
      <h2 class="section-title">
        Why this series. <em>Why now.</em>
      </h2>
    </header>

    <ol class="points" role="list">
      {points.map((p) => (
        <li class="point" data-reveal>
          <span class="point__n">{p.n}</span>
          <div>
            <h3 class="point__claim" set:html={p.claim} />
            <p class="point__body">{p.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .why {
    padding: var(--section-y) var(--gutter);
    background: var(--color-paper-warm);
  }
  .inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .head {
    margin-bottom: 5rem;
    max-width: 48rem;
  }
  .head .meta { margin-bottom: 1rem; }

  .points {
    list-style: none;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
    padding: 0;
    margin: 0;
  }
  .point {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  @media (max-width: 720px) {
    .point { grid-template-columns: 1fr; gap: 1rem; }
  }
  .point__n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-mute);
  }
  .point__claim {
    font-family: var(--font-display);
    font-weight: 350;
    font-variation-settings: "opsz" 60, "SOFT" 30;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }
  .point__claim em {
    font-style: italic;
    font-variation-settings: "opsz" 144, "SOFT" 70, "WONK" 1;
    color: var(--color-bay);
  }
  .point__body {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }
</style>
