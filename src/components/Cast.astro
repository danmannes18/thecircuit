---
// Act Four — The Cast.
import CastCard from './CastCard.astro';
import { castGroups, castByGroup, cast } from '../data/cast';

const bioData = Object.fromEntries(
  cast.map((m) => [
    m.id,
    {
      name: m.name,
      role: m.role,
      home: m.home,
      achievements: m.achievements,
      bio: m.bio,
      narrativeFunction: m.narrativeFunction,
    },
  ]),
);
---

<section id="cast" class="cast">
  <div class="inner">
    <header class="head" data-reveal>
      <p class="meta">The Cast</p>
      <h2 class="section-title">
        Fifteen anchors. <em>Four archetypes. One world.</em>
      </h2>
      <p class="intro">
        Old American champions, billionaires’ children, European nobility, and
        the working-class crew that keeps it all running. The collision of
        these worlds is the show.
      </p>
    </header>

    {castGroups.map((group) => (
      <article class="group" data-reveal>
        <div class="group__label">
          <span>{group.numeral}.</span>
          <span>{group.name}</span>
          <span class="group__subtitle">{group.subtitle}</span>
        </div>

        <div class="grid" data-cast-grid={group.id}>
          {castByGroup(group.id).map((m) => (
            <CastCard id={m.id} number={m.number} name={m.name} role={m.role} />
          ))}
        </div>

        <div class="bio-panel" data-cast-bio={group.id} aria-live="polite"></div>
      </article>
    ))}
  </div>
</section>

<script is:inline type="application/json" id="cast-bios" set:html={JSON.stringify(bioData)}></script>

<style>
  .cast {
    padding: var(--section-y) var(--gutter);
    background: var(--color-paper);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
    max-width: 48rem;
  }
  .intro {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-top: 1.5rem;
  }
  .group {
    margin-bottom: 4rem;
  }
  .group__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .group__subtitle {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-variation-settings: "opsz" 24, "SOFT" 50, "WONK" 1;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.875rem;
    color: var(--color-ink-mute);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .bio-panel {
    overflow: hidden;
    max-height: 0;
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    transition: max-height 600ms var(--ease);
  }
  .bio-panel.is-open {
    max-height: 2000px;
  }
</style>
