---
// Act Four — The Cast.
import CastCard from "./CastCard.astro";
import { castGroups, castByGroup, cast } from "../data/cast";
import type { Discipline, CastMember } from "../data/cast";

const bioData = Object.fromEntries(
  cast.map((m) => [
    m.id,
    {
      name: m.name,
      role: m.role,
      home: m.home,
      achievements: m.achievements,
      bio: m.bio,
      narrativeFunction: m.narrativeFunction,
      discipline: m.discipline,
      instagram: m.instagram,
      wikipedia: m.wikipedia,
    },
  ]),
);

const DISCIPLINE_LABELS: Record<Discipline, string> = {
  "show-jumping": "Show Jumping",
  "dressage": "Dressage",
  "eventing": "Eventing",
  "institutional": "",
};

const NEXT_WAVE_IDS = new Set(["eisner", "propp", "wireman", "torano", "bockmann"]);

type DividerItem = { type: "divider"; label: string };
type CardItem = { type: "card"; member: CastMember };
type GridItem = DividerItem | CardItem;

function buildGridItems(members: CastMember[], withDividers: boolean): GridItem[] {
  if (!withDividers) return members.map((m) => ({ type: "card" as const, member: m }));
  const items: GridItem[] = [];
  let lastLabel = "";
  for (const m of members) {
    const label = NEXT_WAVE_IDS.has(m.id) ? "Next Wave" : (DISCIPLINE_LABELS[m.discipline] || "");
    if (label && label !== lastLabel) {
      lastLabel = label;
      items.push({ type: "divider" as const, label: label.toUpperCase() });
    }
    items.push({ type: "card" as const, member: m });
  }
  return items;
}

const groupGrids = castGroups.map((group) => ({
  group,
  items: buildGridItems(castByGroup(group.id), group.id === "legends" || group.id === "rising"),
}));
---

<section id="cast" class="cast">
  <div class="inner">
    <header class="head" data-reveal>
      <p class="meta">The Cast</p>
      <h2 class="section-title">
        Thirty-five anchors. <em>Four groups. Three disciplines.</em>
      </h2>
      <p class="intro">
        Old American champions, billionaires’ children, European nobility, and
        the working-class crew that keeps it all running — across show jumping,
        dressage, and eventing. The collision of these worlds is the show.
      </p>
    </header>

    {groupGrids.map(({ group, items }) => (
      <article class="group" data-reveal>
        <h3 class="group__label">
          <span class="group__numeral">{group.numeral}.</span>
          <span class="group__name">{group.name}</span>
          <span class="group__subtitle">{group.subtitle}</span>
        </h3>

        <div class="grid" data-cast-grid={group.id}>
          {items.map((item) =>
            item.type === "divider"
              ? <div class="discipline-divider" role="separator"><span>{item.label}</span></div>
              : <CastCard id={item.member.id} number={item.member.number} name={item.member.name} role={item.member.role} discipline={item.member.discipline} />
          )}
        </div>

      </article>
    ))}
  </div>
</section>

<script is:inline type="application/json" id="cast-bios" set:html={JSON.stringify(bioData)}></script>

<style>
  .cast {
    padding: var(--section-y) var(--gutter);
    background: var(--color-paper);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
    max-width: 48rem;
  }
  .intro {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin-top: 1.5rem;
  }
  .group {
    margin-bottom: 4rem;
  }
  .group__label {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    margin: 0 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }
  .group__name {
    color: var(--color-ink);
  }
  .group__subtitle {
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-variation-settings: "opsz" 24, "SOFT" 50, "WONK" 1;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.875rem;
    color: var(--color-ink-mute);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .discipline-divider {
    grid-column: 1 / -1;
    padding: 0.75rem 1.5rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: transparent;
  }
  .discipline-divider span {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-mute);
  }
  /* Bio panel is injected dynamically by JS — must be :global */
  :global(.bio-panel) {
    grid-column: 1 / -1;
    overflow: hidden;
    max-height: 0;
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    transition: max-height 600ms var(--ease);
    background: var(--color-paper-warm);
  }
  :global(.bio-panel.is-open) {
    max-height: 2400px;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.bio-panel) { transition: none; }
  }
  :global(.bio-panel .bio__inner) {
    padding: 2.75rem var(--gutter);
    max-width: 56rem;
    margin: 0 auto;
  }
  :global(.bio-panel .bio__name) {
    font-family: var(--font-display);
    font-weight: 350;
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
    letter-spacing: -0.025em;
    line-height: 1;
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    color: var(--color-ink);
    margin-bottom: 1.5rem;
  }
  :global(.bio-panel .bio__meta) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem 2rem;
    margin: 0 0 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  :global(.bio-panel .bio__meta-row dt) {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    margin-bottom: 0.4rem;
  }
  :global(.bio-panel .bio__meta-row dd) {
    font-family: var(--font-display);
    font-weight: 350;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin: 0;
  }
  :global(.bio-panel .bio__body p) {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    margin-bottom: 1.25em;
    max-width: var(--measure);
  }
  :global(.bio-panel .bio__body p:last-child) { margin-bottom: 0; }
  :global(.bio-panel .bio__function) {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 24, "SOFT" 50, "WONK" 1;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-bay);
    padding-top: 1.5rem;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }
  :global(.bio-panel .bio__function-label) {
    font-family: var(--font-mono);
    font-weight: 400;
    font-style: normal;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
    display: block;
    margin-bottom: 0.5rem;
  }
  :global(.bio-panel .bio__social) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 1rem 0;
    margin: 0.5rem 0;
    border-top: 1px solid var(--rule);
  }
  :global(.bio-panel .bio__social-link) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-mute);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  :global(.bio-panel .bio__social-link:hover) {
    color: var(--color-ink);
  }
</style>
