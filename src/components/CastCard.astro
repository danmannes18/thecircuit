---
interface Props {
  number: string;
  name: string;
  role: string;
}
const { number, name, role } = Astro.props;
---

<button class="card" type="button" aria-expanded="false">
  <span class="num">{number}</span>
  <span class="name display-md">{name}</span>
  <span class="role">{role}</span>
  <span class="plus" aria-hidden="true">+</span>
</button>

<style>
  .card {
    text-align: left;
    width: 100%;
    padding: 1.5rem 1.25rem 1.75rem;
    background: transparent;
    border: 1px solid var(--rule);
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    row-gap: 0.5rem;
    transition: background-color 400ms var(--ease), border-color 400ms var(--ease);
  }
  .card:hover {
    background: var(--color-paper-warm);
    border-color: rgba(10, 10, 10, 0.2);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-mute);
    grid-row: 1;
  }
  .name {
    grid-column: 1 / -1;
    grid-row: 2;
    font-size: 1.5rem;
    color: var(--color-ink);
  }
  .role {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 60, "SOFT" 50, "WONK" 1;
    color: var(--color-ink-mute);
    font-size: 1rem;
  }
  .plus {
    grid-row: 1;
    grid-column: 3;
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--color-ink-mute);
    transition: transform 400ms var(--ease);
  }
  .card[aria-expanded="true"] .plus {
    transform: rotate(45deg);
  }
</style>
