---
interface Props {
  id: string;
  number: string;
  name: string;
  role: string;
}
const { id, number, name, role } = Astro.props;
---

<button
  type="button"
  class="card"
  data-card={id}
  aria-expanded="false"
  aria-controls={`bio-${id}`}
>
  <span class="num">{number}</span>
  <span class="plus" aria-hidden="true">+</span>
  <span class="name">{name}</span>
  <span class="role">{role}</span>
</button>

<style>
  .card {
    text-align: left;
    width: 100%;
    padding: 1.5rem 1.25rem 1.75rem;
    background: transparent;
    border: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    column-gap: 1rem;
    row-gap: 0.5rem;
    transition: background-color 400ms var(--ease), border-color 400ms var(--ease);
  }
  .card:hover {
    background: var(--color-paper-warm);
    border-color: rgba(10, 10, 10, 0.2);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-bay);
    outline-offset: 2px;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-mute);
    grid-row: 1;
    grid-column: 1;
  }
  .plus {
    grid-row: 1;
    grid-column: 2;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-ink-mute);
    transition: transform 400ms var(--ease);
  }
  .card[aria-expanded="true"] .plus {
    transform: rotate(45deg);
  }
  .name {
    grid-column: 1 / -1;
    grid-row: 2;
    font-family: var(--font-display);
    font-weight: 350;
    font-variation-settings: "opsz" 60, "SOFT" 30, "WONK" 0;
    letter-spacing: -0.015em;
    line-height: 1.1;
    font-size: 1.5rem;
    color: var(--color-ink);
    margin-top: 1.5rem;
  }
  .role {
    grid-column: 1 / -1;
    grid-row: 3;
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: "opsz" 60, "SOFT" 50, "WONK" 1;
    color: var(--color-ink-mute);
    font-size: 1rem;
  }
</style>
