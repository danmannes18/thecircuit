---
import type { Season } from '../data/episodes';
interface Props { season: Season; }
const { season } = Astro.props;
---

<article class="season">
  <header class="season__head">
    <p class="meta">Season {season.number} — {season.year}</p>
    <h3 class="display-md title">
      <em>{season.title}</em>
    </h3>
    <p class="lede">{season.summary}</p>
  </header>

  <ol class="episodes" role="list">
    {season.episodes.map((ep) => (
      <li class="ep rule-t">
        <span class="ep__num meta">{ep.number}</span>
        <div class="ep__body">
          <p class="ep__title display-md">{ep.title}</p>
          <p class="ep__synopsis">{ep.synopsis}</p>
        </div>
      </li>
    ))}
  </ol>
</article>

<style>
  .season {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .season__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .title {
    font-size: 2rem;
  }
  .episodes {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ep {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
  }
  .ep__num {
    color: rgba(245, 241, 232, 0.5);
  }
  .ep__title {
    font-size: 1.25rem;
    color: var(--color-paper);
  }
  .ep__synopsis {
    color: rgba(245, 241, 232, 0.65);
    font-size: 0.95rem;
    margin-top: 0.35rem;
    max-width: 55ch;
  }
</style>
