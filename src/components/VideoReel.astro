<section class="reel" aria-label="Footage reel">
  <div class="reel__track" id="reel-track">
    {clips.map((src) => (
      <div class="reel__cell">
        <video class="reel__video" muted loop playsinline preload="none" data-lazy-video>
          <source data-src={src} type="video/mp4" />
        </video>
      </div>
    ))}
  </div>
</section>

<style>
  .reel {
    overflow: hidden;
    background: var(--color-ink);
    padding: 0;
  }
  .reel__track {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px;
  }
  .reel__track::-webkit-scrollbar { display: none; }
  .reel__cell {
    flex: 0 0 clamp(180px, 22vw, 280px);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    scroll-snap-align: start;
    background: #0a0604;
    position: relative;
  }
  .reel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
