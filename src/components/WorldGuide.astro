    position: relative;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }

  .tablist {
    display: flex;
    flex-direction: row;
    gap: 2.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 0;
  }

  .tablist::-webkit-scrollbar {
    display: none;
  }

  .tab-fade-right {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 1px;
