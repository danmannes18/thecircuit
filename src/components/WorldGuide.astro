    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-mute);
    margin: 0 0 1.25rem;
  }

  .guide-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-variation-settings: "opsz" 144, "SOFT" 30, "WONK" 0;
