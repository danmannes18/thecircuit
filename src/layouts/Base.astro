---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'The Circuit — A premium documentary series',
  description = 'Inside the billion-dollar world of international show jumping. Two seasons. The road to Los Angeles 2028.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content="The Circuit" />
    <meta property="og:description" content="A premium documentary series. Two seasons. The road to Los Angeles 2028." />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <slot />
    <script>
      import { initReveal } from '../lib/reveal';
      import { initCast } from '../lib/cast';
      initReveal();
      initCast();
    </script>
  </body>
</html>
